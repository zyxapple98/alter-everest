{
  "name": "alter-everest",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyxapple98/alter-everest.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build:dem": "node scripts/build-everest-dem.mjs",
    "agent:inspect": "tsx scripts/inspect-world.ts",
    "build:list": "node scripts/community-builds.mjs list",
    "build:inspect": "node scripts/community-builds.mjs inspect",
    "build:start": "node scripts/community-builds.mjs start",
    "build:intend": "node scripts/community-builds.mjs intend",
    "build:comment": "node scripts/community-builds.mjs comment",
    "site:query": "tsx scripts/query-site.ts",
    "world:query": "tsx scripts/query-world.ts",
    "terrain:query": "tsx scripts/query-terrain.ts",
    "route:annotate": "tsx scripts/annotate-route.ts",
    "route:evaluate": "tsx scripts/evaluate-route.ts",
    "physics:benchmark": "tsx scripts/benchmark-physics.ts",
    "expedition:check": "tsx scripts/validate-expedition.ts",
    "expedition:apply": "tsx scripts/apply-expedition.ts",
    "expedition:receipt": "tsx scripts/issue-receipt.ts",
    "expedition:reduce": "tsx scripts/reduce-expedition.ts",
    "expedition:e2e": "node --import tsx --test tests/expedition-e2e.test.ts",
    "expedition:scope": "node scripts/candidate-pr-scope.mjs",
    "verifier:hash": "tsx -e \"import('./scripts/verifier-integrity.ts').then(async m => console.log(await m.computeVerifierHash()))\"",
    "verifier:keys": "node scripts/generate-verifier-keys.mjs",
    "world:feed": "tsx scripts/build-world-feed.ts",
    "world:r2:manifest": "node scripts/build-r2-publish-manifest.mjs",
    "world:r2:publish": "node scripts/publish-world-r2.mjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run build:static && node --import tsx --test tests/*.test.ts tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "geotiff": "^3.0.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
