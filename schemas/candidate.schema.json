{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alter-everest.invalid/schemas/candidate.schema.json",
  "title": "ALTER EVEREST expedition candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "parentWorldHash",
    "terrainHash",
    "agentId",
    "proof"
  ],
  "properties": {
    "protocol": {
      "const": "0.4.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "parentWorldHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "terrainHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "vec3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "w": { "type": "number" }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation", "rotation"],
      "properties": {
        "translation": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quaternion" }
      }
    },
    "voxel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z",
        "altitudeM",
        "slopeDegrees",
        "surface",
        "mode"
      ],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "altitudeM": { "type": "number" },
        "slopeDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "surface": {
          "enum": ["ROCK", "SNOW", "ICE"]
        },
        "mode": {
          "enum": ["WALK", "SCRAMBLE", "CLIMB"]
        },
        "protected": { "type": "boolean" },
        "safeStop": { "type": "boolean" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "matterId", "source", "destination"],
      "properties": {
        "kind": { "const": "RELOCATE" },
        "matterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "BASE" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "stoneId"],
              "properties": {
                "kind": { "const": "STONE" },
                "stoneId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "voxel"],
              "properties": {
                "kind": { "const": "TERRAIN" },
                "voxel": { "$ref": "#/$defs/voxel" }
              }
            }
          ]
        },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "BASE" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "releasePose"],
              "properties": {
                "kind": { "const": "WORLD" },
                "releasePose": { "$ref": "#/$defs/pose" }
              }
            }
          ]
        }
      },
      "not": {
        "properties": {
          "source": {
            "properties": { "kind": { "const": "BASE" } },
            "required": ["kind"]
          },
          "destination": {
            "properties": { "kind": { "const": "BASE" } },
            "required": ["kind"]
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "mutation"],
      "properties": {
        "route": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/sample" }
        },
        "mutation": { "$ref": "#/$defs/mutation" },
        "pickupIndex": {
          "type": "integer",
          "minimum": 0
        },
        "releaseIndex": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
