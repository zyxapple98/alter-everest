{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alter-everest.invalid/schemas/candidate.schema.json",
  "title": "ALTER EVEREST expedition candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "parentWorldHash",
    "terrainHash",
    "agentId",
    "proof"
  ],
  "properties": {
    "protocol": {
      "const": "0.8.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "parentWorldHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "terrainHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 39,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9]))*$"
    },
    "proof": {
      "$ref": "#/$defs/proof"
    }
  },
  "$defs": {
    "voxel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codec", "start", "stepCount", "program"],
      "properties": {
        "codec": { "const": "ae-microtrace-v2" },
        "start": { "$ref": "#/$defs/voxel" },
        "stepCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250000
        },
        "program": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        "acceptOneWayDeath": { "type": "boolean" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "matterId",
        "source",
        "destination",
        "pickupStep",
        "releaseStep"
      ],
      "properties": {
        "kind": { "const": "RELOCATE" },
        "matterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "BASE" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "const": "STONE" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "voxel"],
              "properties": {
                "kind": { "const": "TERRAIN" },
                "voxel": { "$ref": "#/$defs/voxel" }
              }
            }
          ]
        },
        "destination": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "BASE" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "cell"],
              "properties": {
                "kind": { "const": "WORLD" },
                "cell": { "$ref": "#/$defs/voxel" }
              }
            }
          ]
        },
        "pickupStep": {
          "type": "integer",
          "minimum": 0
        },
        "releaseStep": {
          "type": "integer",
          "minimum": 0
        }
      },
      "not": {
        "properties": {
          "source": {
            "properties": { "kind": { "const": "BASE" } },
            "required": ["kind"]
          },
          "destination": {
            "properties": { "kind": { "const": "BASE" } },
            "required": ["kind"]
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "actions"],
      "properties": {
        "route": {
          "$ref": "#/$defs/route"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    }
  }
}
