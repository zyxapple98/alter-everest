FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

WORKDIR /verifier

COPY --chown=node:node package.json ./
COPY --chown=node:node ci/expedition-runtime/package.json ci/expedition-runtime/package-lock.json ./ci/expedition-runtime/
RUN npm ci --ignore-scripts --no-audit --no-fund --prefix ci/expedition-runtime \
    && npm cache clean --force

COPY --chown=node:node engine ./engine
COPY --chown=node:node lib ./lib
COPY --chown=node:node protocol ./protocol
COPY --chown=node:node public/data ./public/data
COPY --chown=node:node schemas ./schemas
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node world ./world

USER node

ENTRYPOINT ["node", "--import", "./ci/expedition-runtime/node_modules/tsx/dist/loader.mjs", "scripts/issue-receipt.ts"]
